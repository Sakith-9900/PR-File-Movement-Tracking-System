{
  "name": "PO",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Auto-generated PO number"
    },
    "po_date": {
      "type": "string",
      "format": "date",
      "description": "Date of PO creation"
    },
    "rfq_id": {
      "type": "string",
      "description": "Reference to RFQ"
    },
    "rfq_number": {
      "type": "string",
      "description": "RFQ number for reference"
    },
    "pr_file_id": {
      "type": "string",
      "description": "Reference to PRFile/Contract"
    },
    "pr_number": {
      "type": "string",
      "description": "PR number for reference"
    },
    "contract_name": {
      "type": "string",
      "description": "Contract name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Open"
    },
    "remarks": {
      "type": "string",
      "description": "PO remarks"
    }
  },
  "required": [
    "po_number",
    "po_date",
    "pr_file_id"
  ]
}